APP_NAME="Catalogo Almacen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQL Server. Con instancia con nombre (SERVIDOR\INSTANCIA) DB_PORT debe ir VACIO:
# el SQL Server Browser resuelve el puerto. Con instancia por defecto use 1433.
DB_CONNECTION=sqlsrv
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_DATABASE=catalogo_almacen
DB_USERNAME=catalogo_app
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# sync = el correo sale en la misma peticion, sin worker.
# Para usar cola: database + php artisan queue:work
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="almacen@sidocsa.com"
MAIL_FROM_NAME="${APP_NAME}"

# Correos que reciben aviso cuando entra una solicitud nueva (separar con coma). Opcional.
ALMACEN_NOTIFICACION_EMAIL=

# Datos de contacto que se muestran al solicitante
ALMACEN_NOMBRE="Almacen de Repuestos"
ALMACEN_HORARIO="Lunes a viernes de 7:00 a.m. a 5:00 p.m."
ALMACEN_UBICACION="Ventanilla del almacen, primer piso"

VITE_APP_NAME="${APP_NAME}"

# Storage de Supabase con las fotos de repuestos (repuestos:sincronizar-supabase).
SUPABASE_URL=
SUPABASE_BUCKET=
SUPABASE_KEY=
SUPABASE_BUCKET_PUBLICO=true
