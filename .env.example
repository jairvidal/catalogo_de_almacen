APP_NAME="Catalogo Almacen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQL Server. Con instancia con nombre (SERVIDOR\INSTANCIA) DB_PORT debe ir VACIO:
# el SQL Server Browser resuelve el puerto. Con instancia por defecto use 1433.
DB_CONNECTION=sqlsrv
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_DATABASE=catalogo_almacen
DB_USERNAME=catalogo_app
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# sync = el correo sale en la misma peticion, sin worker.
# Para usar cola: database + php artisan queue:work
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="almacen@sidocsa.com"
MAIL_FROM_NAME="${APP_NAME}"

# Correos que reciben aviso cuando entra una solicitud nueva (separar con coma). Opcional.
ALMACEN_NOTIFICACION_EMAIL=

# Datos de contacto que se muestran al solicitante
ALMACEN_NOMBRE="Almacen de Repuestos"
ALMACEN_HORARIO="Lunes a viernes de 7:00 a.m. a 5:00 p.m."
ALMACEN_UBICACION="Ventanilla del almacen, primer piso"

VITE_APP_NAME="${APP_NAME}"

# Storage de Supabase con las fotos de repuestos (repuestos:sincronizar-supabase).
SUPABASE_URL=
SUPABASE_BUCKET=
SUPABASE_KEY=
SUPABASE_BUCKET_PUBLICO=true

# Busqueda de repuestos por imagen con la API de Claude (Anthropic).
# Sin ANTHROPIC_API_KEY los botones del catalogo responden "no disponible".
# Antes de usarla hay que construir el indice: php artisan repuestos:indexar-imagenes
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MODELO=claude-opus-5-5
# low | medium | high | xhigh | max. Dejar vacio con modelos que no lo aceptan (Haiku 4.5).
ANTHROPIC_ESFUERZO=low
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_TIMEOUT=90
# fallbacks "default" del lado de Anthropic (solo Opus 5.5 / Opus 5 / Fable 5.1 / Sonnet 5.5).
ANTHROPIC_FALLBACK_SERVIDOR=true
# Precios en USD por millon de tokens (Claude Opus 5.5). Si cambia el modelo, cambie los precios.
ANTHROPIC_PRECIO_ENTRADA=4.00
ANTHROPIC_PRECIO_SALIDA=20.00
ANTHROPIC_PRECIO_CACHE_ESCRITURA=5.00
ANTHROPIC_PRECIO_CACHE_LECTURA=0.20
# Bitacora del costo de cada consulta, en storage/logs.
ANTHROPIC_LOG_COSTOS=claude-costos.txt
ANTHROPIC_IMAGEN_UMBRAL=80
ANTHROPIC_IMAGEN_MAX_KB=10240
ANTHROPIC_IMAGEN_LADO_CONSULTA=1024
ANTHROPIC_IMAGEN_LADO_CATALOGO=512
ANTHROPIC_IMAGEN_LADO_INDICE=768
ANTHROPIC_IMAGEN_CANDIDATOS=8
ANTHROPIC_IMAGEN_VERIFICAR=true
ANTHROPIC_IMAGEN_LOTE_INDICE=8
ANTHROPIC_IMAGEN_POR_MINUTO=5
ANTHROPIC_IMAGEN_POR_DIA=300
